{
  "name": "Proffy",
  "version": "1.1.0",
  "description": "This is the backend for Proffy. An app that connects people who want to teach with people who want to take lessons.",
  "main": "src/server.ts",
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "pretest:e2e": "run-s test:create-prisma-environment test:install-prisma-environment",
    "test:e2e:watch": "vitest --project e2e",
    "pretest:e2e:watch": "run-s test:create-prisma-environment test:install-prisma-environment",
    "test:create-prisma-environment": "npm link ./prisma/vitest-environment-prisma",
    "test:install-prisma-environment": "npm link vitest-environment-prisma",
    "dev": "tsx watch src/server.ts",
    "build": "tsup src",
    "start": "node dist/server.js",
    "lint": "npx @biomejs/biome check --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/jwt": "10.0.0",
    "@prisma/client": "6.17.1",
    "bcryptjs": "3.0.2",
    "dayjs": "1.11.18",
    "dotenv": "17.2.3",
    "fastify": "^5.6.1",
    "npm-run-all": "4.1.5",
    "supertest": "7.1.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/node": "24.7.1",
    "@types/supertest": "6.0.3",
    "prisma": "6.17.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
